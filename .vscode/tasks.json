{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build Debug APK",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        ":app:assembleDebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gradle"
      ]
    },
    {
      "label": "Android: Install Debug APK",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        ":app:installDebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gradle"
      ]
    },
    {
      "label": "Android: Run on Connected Device",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run-android.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
